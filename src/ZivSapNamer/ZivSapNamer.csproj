<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>True</NoDefaultLaunchSettingsFile>
    <UserSecretsId>ZivSapNamer</UserSecretsId>
    <EnableSapNco Condition="'$(EnableSapNco)' == ''">false</EnableSapNco>
    <SapNcoPath Condition="'$(SapNcoPath)' == ''">$(MSBuildProjectDirectory)/../../lib/sapnco</SapNcoPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableSapNco)' == 'true'">
    <DefineConstants>$(DefineConstants);SAP_NCO</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableSapNco)' == 'true'">
    <Reference Include="sapnco">
      <HintPath>$(SapNcoPath)/sapnco.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="sapnco_utils">
      <HintPath>$(SapNcoPath)/sapnco_utils.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateSapNco" BeforeTargets="ResolveAssemblyReferences" Condition="'$(EnableSapNco)' == 'true'">
    <Error Condition="!Exists('$(SapNcoPath)/sapnco.dll') Or !Exists('$(SapNcoPath)/sapnco_utils.dll')"
           Text="Install the .NET 8 x64 SAP .NET Connector assemblies in $(SapNcoPath), or set SapNcoPath to their directory. See README.md." />
  </Target>

</Project>
